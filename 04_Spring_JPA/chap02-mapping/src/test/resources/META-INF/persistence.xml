<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="jpatest">
<!--        <class>com.bear.section01.entity.Member</class>-->
<!--        <class>com.bear.section02.enum_type.Member</class>-->
        <class>com.bear.section03.field.Member</class>
        <class>com.bear.practice.ColumnMember</class>
        <class>com.bear.practice.EntityNameMember</class>
        <class>com.bear.practice.IdentityMember</class>
        <class>com.bear.practice.EnumMember</class>
        <class>com.bear.practice.PropertyAccessMember</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="1234"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/menudb"/>

            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.highlight_sql" value="true"/>

            <!-- Entity 클래스 기준으로 Hibernate가 DDL을 자동으로 만들어주는 옵션 -->
            <!-- value = "none": 아무것도 하지 않음. "create": 실행할 때마다 기존 DROP, 새로 생성
                "create-drop": create와 같지만 어플리케이션 종료할 때 Drop
                "update": 기존 테이블을 유지한채 변경된 부분(컬럼 추가)만 반영
                "validate": DDL 실행을 하지 않고 구조가 맞는지 검증만 진행
             -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
        </properties>

    </persistence-unit>

</persistence>